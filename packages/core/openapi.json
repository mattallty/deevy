{
  "info": {
    "title": "deevy",
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "openapi": "3.1.2",
  "paths": {
    "/health/ping": {
      "get": {
        "operationId": "health.ping",
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "time"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "me.get",
        "summary": "The signed-in Human, their Member row, and the Workspace",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "image": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "kind": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "human",
                                "agent"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "email",
                        "image",
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    "member": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "workspaceId": {
                              "type": "string"
                            },
                            "userId": {
                              "type": "string"
                            },
                            "role": {
                              "type": "string",
                              "enum": [
                                "admin",
                                "member"
                              ]
                            },
                            "kind": {
                              "type": "string",
                              "enum": [
                                "human",
                                "agent"
                              ]
                            },
                            "sponsorId": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "createdAt": {
                              "type": "string",
                              "format": "date-time",
                              "x-native-type": "date"
                            },
                            "suspendedAt": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "format": "date-time",
                                  "x-native-type": "date"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "workspaceId",
                            "userId",
                            "role",
                            "kind",
                            "sponsorId",
                            "createdAt",
                            "suspendedAt"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "workspace": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "slug": {
                              "type": "string"
                            },
                            "createdAt": {
                              "type": "string",
                              "format": "date-time",
                              "x-native-type": "date"
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "slug",
                            "createdAt"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "user",
                    "member",
                    "workspace"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/workspace": {
      "get": {
        "operationId": "workspace.get",
        "summary": "The Workspace this instance serves",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "slug": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "x-native-type": "date"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "slug",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
