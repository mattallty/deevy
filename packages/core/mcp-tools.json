      "type": "object",
      "properties": {
        "issueKey": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "issueKey",
        "name",
        "body"
      ]
    }
  },
  {
    "name": "inbox_list",
    "operation": "inbox.list",
    "summary": "The Notifications waiting for you, newest first",
    "readOnly": true,
    "agents": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "unreadOnly": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "before": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    }
  },
  {
    "name": "issues_create",
    "operation": "issues.create",
    "summary": "Add an Issue to a Project, in the first State of its Workflow",
    "readOnly": false,
    "agents": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "assigneeMemberId": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentKey": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "projectKey",
        "title"
      ]
    }
  },
  {
    "name": "issues_get",
    "operation": "issues.get",
    "summary": "One Issue by its key, with its State, Assignee, parent and children",
    "readOnly": true,
    "agents": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key"
      ]
    }
  },
  {
    "name": "issues_list",
    "operation": "issues.list",
    "summary": "A Project's Issues, by number, from a cursor",
    "readOnly": true,
    "agents": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}$"
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stateId": {
          "type": "string"
        },
        "assigneeMemberId": {
          "type": "string"
        },
        "labelId": {
          "type": "string"
        },
        "open": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "limit": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "projectKey"
      ]
    }
  },
  {
