          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      },
      "required": [
        "runId",
        "status",
        "summary"
      ]
    }
  },
  {
    "name": "runs_get",
    "operation": "runs.get",
