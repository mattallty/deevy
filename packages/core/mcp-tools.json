  {
    "name": "links_add",
    "operation": "links.add",
    "summary": "Point an Issue at a pull request, a commit, a branch, or any URL",
    "readOnly": false,
    "agents": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "issueKey": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "pull_request",
            "commit",
            "branch",
            "url"
          ]
        },
        "runId": {
          "type": "string"
        }
      },
      "required": [
        "issueKey",
        "url"
      ]
    }
  },
  {
    "name": "runs_finish",
