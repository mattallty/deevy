[
  {
    "name": "comments_create",
    "operation": "comments.create",
    "summary": "Say something on an Issue, mentioning Members and Teams by handle",
    "readOnly": false,
    "agents": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "issueKey": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "issueKey",
        "body"
      ]
    }
  },
  {
    "name": "documents_get",
    "operation": "documents.get",
