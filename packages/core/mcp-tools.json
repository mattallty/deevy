    "readOnly": true,
    "agents": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "issueKey": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "issueKey",
        "name"
      ]
    }
  },
  {
    "name": "documents_write",
    "operation": "documents.write",
