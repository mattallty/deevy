{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        ". \"$HOME/.config/vite-plus/env\" 2>/dev/null; command vp run -r --parallel dev"
      ],
      "port": 5173,
      "autoPort": true,
      "env": {
        "DEEVY_PORT": "3010"
      }
    },
    {
      "name": "dev:stub",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        ". \"$HOME/.config/vite-plus/env\" 2>/dev/null; BETTER_AUTH_URL=\"http://localhost:${PORT:-5173}\" command vp run -r --parallel dev"
      ],
      "port": 5173,
      "autoPort": true,
      "env": {
        "DEEVY_DEV_STUB_OAUTH": "1",
        "DEEVY_DATABASE_PATH": "./data/stub.sqlite",
        "DEEVY_PORT": "3010"
      }
    }
  ]
}
