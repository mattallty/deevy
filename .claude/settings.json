{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/copy-env-to-worktree.sh",
            "timeout": 10,
            "statusMessage": "Checking this worktree's .env"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/copy-env-to-worktree.sh",
            "timeout": 10,
            "statusMessage": "Checking this worktree's .env"
          }
        ]
      }
    ]
  }
}
