# Copy to apps/web/.dev.vars for `wrangler dev`. Never commit .dev.vars.
#
# wrangler reads this file from the directory holding wrangler.jsonc, and it is
# the local stand-in for `wrangler secret put` on a deployment. The names are
# the ones apps/server reads from the environment; docs/OPERATIONS.md has the
# table of what each one does on either runtime.

# Public URL of the Worker; Better Auth derives its callback URLs from it, and
# the MCP challenge names it. Without it, deevy answers on whatever origin the
# request arrived at.
BETTER_AUTH_URL=http://localhost:8787
# At least 32 random characters. Generate with: npx auth@1.7.2 secret
BETTER_AUTH_SECRET=
# GitHub OAuth App. Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The first sign-in with this email becomes the Workspace admin and creates the Workspace.
DEEVY_ADMIN_EMAIL=
DEEVY_WORKSPACE_NAME=deevy
